# Etapa 1: Construcción con Maven y JDK 17
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copiar archivos necesarios para descargar dependencias
COPY pom.xml .
COPY mvnw .
COPY .mvn .mvn

RUN ./mvnw dependency:go-offline

# Copiar el código fuente
COPY src src

# Empaquetar la aplicación (sin tests para acelerar)
RUN ./mvnw clean package -DskipTests

# Etapa 2: Imagen para ejecutar la aplicación (JRE slim)
FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

# Copiar el JAR construido
COPY --from=build /app/target/*.jar app.jar

# Puerto que expondrá el contenedor
EXPOSE 8080

# Comando para ejecutar la app
ENTRYPOINT ["java", "-jar", "app.jar"]
